#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

PROFILES="fast all"

# Root package의 MariaDb/Postgres 테스트만 Testcontainers로 Docker를 씁니다.
# 하위 package의 테스트는 Docker 없이 돕니다.
BACKEND_ROOT_PACKAGE='kr.co.unidocs.monitoring'
BACKEND_TEST_ROOT="$ROOT/backend/src/test/java/${BACKEND_ROOT_PACKAGE//.//}"

run() {
  echo
  echo "==> ($1) ${*:2}"
  (cd "$ROOT/$1" && "${@:2}")
}

require_frontend_deps() {
  if [ ! -d "$ROOT/frontend/node_modules" ]; then
    echo "frontend/node_modules가 없습니다. frontend에서 'npm ci'를 먼저 실행해 주세요." >&2
    exit 1
  fi
}

frontend() {
  require_frontend_deps
  run frontend npm run lint
  run frontend npm test
  run frontend npm run build
}

# 하위 package를 목록으로 적어 두면 새 package의 테스트가 fast에서 조용히 빠집니다.
backend_fast() {
  local args=()
  local dir
  for dir in "$BACKEND_TEST_ROOT"/*/; do
    [ -d "$dir" ] || continue
    args+=(--tests "$BACKEND_ROOT_PACKAGE.$(basename "$dir").*")
  done
  if [ ${#args[@]} -eq 0 ]; then
    echo "Docker 없이 도는 Backend 테스트가 없습니다: $BACKEND_TEST_ROOT" >&2
    exit 1
  fi
  run backend ./gradlew test "${args[@]}"
}

backend_all() {
  run backend ./gradlew build
}

# 가장 느리므로 마지막에 둡니다. 앞 단계가 실패하면 여기까지 오지 않습니다.
frontend_e2e() {
  run frontend npm run test:e2e
}

usage() {
  echo "사용법: scripts/verify <list|$(echo "$PROFILES" | tr ' ' '|')>" >&2
}

case "${1:-}" in
  list)
    printf '%s\n' $PROFILES
    ;;
  fast)
    frontend
    backend_fast
    ;;
  all)
    frontend
    backend_all
    frontend_e2e
    ;;
  "")
    usage
    exit 2
    ;;
  *)
    echo "지원하지 않는 profile입니다: $1" >&2
    usage
    exit 2
    ;;
esac
