# 환경변수와 Secret
.env
.env.local
*.local

# Secret 파일
# Bot Token과 Webhook Token은 Git에 올리지 않습니다.
infrastructure/secrets/*
!infrastructure/secrets/*.example

# 운영 명령이 .env에서 펼친 코어 설정입니다(core-server.sh render). 펼칠 때마다 다시 만듭니다.
infrastructure/rendered/

# 개발 PC의 CA 인증서 파일입니다(core-dev.bat start가 공식 이미지에서 꺼내 둠). 코어 서버에서는 운영자가 OS의 파일을 복사합니다.
infrastructure/certs/

# 예전 Alertmanager secret 위치입니다. 남아 있는 파일도 올리지 않습니다.
infrastructure/alertmanager/secrets/

# 내부망 서버로 옮길 코어 묶음(scripts/build-core-bundle.mjs)
dist/

# Backend
backend/build/
backend/.gradle/
backend/bin/
backend/out/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db
