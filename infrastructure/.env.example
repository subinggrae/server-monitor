# 모니터링 코어 설정 예시
#
# 이 파일을 같은 디렉터리의 .env로 복사해서 사용합니다.
#   cp infrastructure/.env.example infrastructure/.env
#
# 노출돼도 되는 값만 둡니다. webhook token은 아래 CORE_SECRETS_DIR 폴더의 alertmanager_webhook_token 파일에 둡니다.
# 코어와 앱의 약속은 docs/INTEGRATION.md에 있습니다.

# ---------------------------------------------------------------------------
# 코어가 부를 앱 주소
#
# Prometheus가 HTTP SD 두 곳을, Alertmanager가 webhook을 이 주소로 부릅니다.
# 같은 호스트의 Docker 네트워크 monitoring 안에서 닿는 host:port입니다. 앞에 http://를 붙이지 않습니다.
# 바꾸면 설정을 다시 펼쳐 코어를 띄웁니다. 묶음 폴더에서는 sh core-server.sh start입니다.
# 운영 명령 없이 Compose로 띄울 때도 먼저 sh core-server.sh render로 펼칩니다.
# ---------------------------------------------------------------------------
MONITORING_APP_ADDRESS=manager-api:8080

# ---------------------------------------------------------------------------
# webhook token 파일이 있는 폴더
#
# 비워 두면 저장소에서는 이 파일 옆의 secrets/를, 내부망 서버의 묶음에서는 설치 폴더의 secrets/
# (묶음 폴더의 상위 폴더, ../secrets)를 씁니다. 묶음은 버전마다 새 폴더지만 설치 폴더는 그대로라
# 관리자 서버와 같은 token 파일을 계속 씁니다. 다른 곳에 두려면 경로를 적습니다.
# ---------------------------------------------------------------------------
# CORE_SECRETS_DIR=/opt/monitoring/secrets

# ---------------------------------------------------------------------------
# 서버에서 바꾸는 코어 값
#
# 필요할 때만 줄 앞의 #을 지우고 값을 적습니다. 적지 않거나 비워 두면 기본값을 씁니다.
# 값은 단위 없이 숫자만 적고, 앞에 0을 붙이지 않습니다(예: 30은 되고 30d, 030은 안 됩니다).
# 바꾼 뒤에는 코어를 다시 띄웁니다. 묶음 폴더에서는 sh core-server.sh start입니다.
# 운영 명령이 값을 먼저 검사하고, 틀린 값이 있으면 무엇을 어떻게 고칠지 보인 뒤 아무것도 바꾸지 않습니다.
# 셸에 같은 이름의 환경 변수가 있으면 이 파일보다 그 값을 먼저 씁니다.
# ---------------------------------------------------------------------------

# 기록 보관 기간(일). 기본값 15, 허용 범위 1~365
# 이 기간이 지난 기록부터 지웁니다. 늘리면 그만큼 디스크를 더 씁니다.
# 줄이면 새 기간을 넘는 기록이 지워져 되돌릴 수 없으므로, 운영 명령이 띄우기 전에 확인을 묻습니다.
# CORE_RETENTION_DAYS=15

# 기록 보관 용량(GB). 기본값 없음(용량을 제한하지 않음), 허용 범위 1 이상 999999999 이하
# 기록이 이 용량을 넘으면 보관 기간이 지나지 않았어도 가장 오래된 기록부터 지웁니다.
# 보관 기간과 함께 적으면 먼저 닿는 쪽에 맞춰 지웁니다. 1GB는 1024MB입니다.
# 디스크 크기가 아니라 기록에 쓸 크기를 적습니다. 잠시 이 값을 넘을 수 있으므로 기록을 두는 디스크의 80~85% 이하로 둡니다.
# 처음 정하거나 줄이면 넘는 기록이 지워져 되돌릴 수 없으므로, 운영 명령이 띄우기 전에 확인을 묻습니다.
# CORE_RETENTION_SIZE_GB=50

# 주소 확인 제한 시간(초). 기본값 5, 허용 범위 1~9
# ping, TCP, 웹 주소 확인이 모두 이 시간까지 응답을 기다리고, 넘으면 실패로 봅니다.
# 코어가 확인 결과를 10초 안에 받아야 해서 9초보다 길게 둘 수 없습니다.
# CORE_PROBE_TIMEOUT_SECONDS=5

# 코어 서버에서 여는 포트. 기본값 9090, 9093, 9115, 허용 범위 1024~65535, 세 값은 서로 달라야 합니다
# 코어 서버의 127.0.0.1에서 브라우저, SSH 터널, curl로 열 때 쓰는 포트입니다. 바꿔도 127.0.0.1에만 열립니다.
# 관리자 서버가 부르는 주소(http://prometheus:9090)와 코어끼리 부르는 포트는 바뀌지 않으므로 관리자 서버 설정은 그대로 둡니다.
# CORE_PROMETHEUS_PORT=9090
# CORE_ALERTMANAGER_PORT=9093
# CORE_BLACKBOX_PORT=9115
