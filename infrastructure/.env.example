# 모니터링 코어 설정 예시
#
# 이 파일을 같은 디렉터리의 .env로 복사해서 사용합니다.
#   cp infrastructure/.env.example infrastructure/.env
#
# 노출돼도 되는 값만 둡니다. webhook token은 infrastructure/secrets/alertmanager_webhook_token에 둡니다.
# 코어와 앱의 약속은 docs/INTEGRATION.md에 있습니다.

# ---------------------------------------------------------------------------
# 코어가 부를 앱 주소
#
# Prometheus가 HTTP SD 두 곳을, Alertmanager가 webhook을 이 주소로 부릅니다.
# 같은 호스트의 Docker 네트워크 monitoring 안에서 닿는 host:port입니다. 앞에 http://를 붙이지 않습니다.
# 바꾸면 코어를 다시 띄웁니다.
#   docker compose -f infrastructure/compose.yml up -d
# ---------------------------------------------------------------------------
MONITORING_APP_ADDRESS=manager-api:8080
