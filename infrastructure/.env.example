# 모니터링 코어 설정
#
# 설치 폴더의 .env는 코어(Prometheus, Alertmanager, Blackbox Exporter)만 읽고, 설치한 모든 버전이 함께 씁니다. 관리자 서버는 읽지 않습니다.
# 값을 바꾼 뒤 sh core-server.sh start를 실행해 주세요. 틀린 값이 있으면 코어를 띄우지 않고 고칠 방법을 보여 줍니다.
# 값마다 자세한 설명은 저장소의 docs/OPERATIONS.md(설치 전에 정할 값)에 있습니다.

# 관리자 서버의 컨테이너 이름:포트입니다. http://는 붙이지 않습니다.
MONITORING_APP_ADDRESS=manager-api:8080

# token 파일이 있는 폴더입니다. 비워 두면 설치 폴더의 secrets/를 씁니다(저장소에서는 이 파일 옆의 secrets/).
# CORE_SECRETS_DIR=/opt/monitoring/secrets

# 아래 값은 바꿀 때만 줄 앞의 #을 지우고 숫자만 적어 주세요. 30은 되고 30d, 030은 안 됩니다.

# 기록 보관 기간(일). 기본 15, 1~365
# 늘리면 디스크를 더 쓰고, 줄이면 오래된 기록이 지워져 되돌릴 수 없습니다.
# CORE_RETENTION_DAYS=15

# 기록 보관 용량(GB). 기본은 제한 없음, 1 이상. 기록을 두는 디스크의 80~85% 이하로 적어 주세요.
# 처음 적거나 줄이면 이 용량을 넘는 오래된 기록이 지워지고, 되돌릴 수 없습니다.
# CORE_RETENTION_SIZE_GB=50

# 주소 확인 제한 시간(초). 기본 5, 1~9
# 이 시간 안에 응답이 없으면 확인 실패로 봅니다.
# CORE_PROBE_TIMEOUT_SECONDS=5

# 코어 서버에서 여는 포트(기본 9090, 9093, 9115, 범위 1024~65535). 세 값은 서로 달라야 합니다.
# 다른 프로그램과 겹칠 때만 바꿔 주세요. 바꿔도 코어 서버 안에서만 열리고, 관리자 서버 설정은 바꾸지 않아도 됩니다.
# CORE_PROMETHEUS_PORT=9090
# CORE_ALERTMANAGER_PORT=9093
# CORE_BLACKBOX_PORT=9115
