# Docker가 없는 Linux 감시 대상 서버에서 node_exporter를 서비스로 띄우는 systemd unit이다.
# 설치 방법은 docs/OPERATIONS.md의 OS exporter 설치에 있다.
[Unit]
Description=node_exporter
Wants=network-online.target
After=network-online.target

[Service]
User=node_exporter
ExecStart=/usr/local/bin/node_exporter
Restart=on-failure

[Install]
WantedBy=multi-user.target
