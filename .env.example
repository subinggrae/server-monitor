# Monitoring Manager 환경변수 예시
#
# 이 파일을 .env로 복사해서 사용합니다.
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# 여기에 무엇을 적고 무엇을 적지 않는가
#
# 이 파일에는 노출돼도 문제가 없는 값만 둡니다.
# 주소, 포트, timezone, DB 이름과 계정 이름이 여기에 해당합니다.
#
# 비밀번호, Token, 암호화 키는 여기에 적지 않습니다.
# 그런 값은 infrastructure/secrets/ 아래 파일로 관리합니다.
#
#   운영   Docker Secret     compose.yml의 secrets 항목이 파일을 넣어 줍니다.
#   개발   환경변수 fallback   Docker 없이 띄울 때만 환경변수로 넣습니다.
#
# 자세한 목록은 docs/DEVELOPMENT.md를 참고해 주세요.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Manager Database
#
# Monitoring Manager가 자기 설정을 저장하는 DB입니다.
# 사용자가 모니터링하려는 DB(Database Target)와는 다릅니다.
#
# 제품과 위치는 운영에서 정합니다. 아래 예시 중 하나를 골라 주세요.
# URL 안에 비밀번호를 넣지 마세요. 비밀번호는 secret 파일로 넣습니다.
# ---------------------------------------------------------------------------

# (1) 로컬 개발용 MariaDB를 쓰는 경우
#     docker compose --profile local-db up -d --build
SPRING_DATASOURCE_URL=jdbc:mariadb://manager-db:3306/monitoring_manager
SPRING_DATASOURCE_USERNAME=manager

# (2) 외부 MariaDB나 AWS RDS MariaDB를 쓰는 경우
# SPRING_DATASOURCE_URL=jdbc:mariadb://db.internal:3306/monitoring_manager
# SPRING_DATASOURCE_USERNAME=manager

# (3) 외부 PostgreSQL이나 AWS RDS PostgreSQL을 쓰는 경우
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.internal:5432/monitoring_manager
# SPRING_DATASOURCE_USERNAME=manager

# ---------------------------------------------------------------------------
# local-db profile 전용
#
# manager-db container를 만들 때만 사용합니다.
# 외부 DB를 쓰면 이 값은 무시됩니다.
#
# 비밀번호는 여기에 없습니다.
#   infrastructure/secrets/manager_db_password
#   infrastructure/secrets/manager_db_root_password
# ---------------------------------------------------------------------------
MANAGER_DB_NAME=monitoring_manager
MANAGER_DB_USER=manager

# 호스트에서 manager-db에 접속할 때 쓰는 포트입니다.
# Container 안에서는 항상 3306을 씁니다. 이 값은 DB 도구로 붙어 볼 때만 필요합니다.
# 호스트에 이미 MariaDB나 MySQL이 떠 있으면 3306이 겹치므로 기본값을 13306으로 뒀습니다.
MANAGER_DB_PORT=13306

# ---------------------------------------------------------------------------
# 모니터링 구성요소 주소
#
# PROMETHEUS_URL은 코어의 Prometheus를 Docker network 안에서 부르는 주소입니다.
# GRAFANA_URL만 브라우저가 직접 여는 주소이므로 외부에서 접근 가능한 주소를 넣습니다.
# 코어가 앱을 부르는 주소는 여기가 아니라 infrastructure/.env의 MONITORING_APP_ADDRESS입니다.
# ---------------------------------------------------------------------------
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Telegram /register (선택)
#
# Telegram 그룹에서 /register로 등록하려면 Telegram 서버가 Manager를 부를 수 있어야 합니다.
# 외부에서 접근 가능한 HTTPS 주소가 필요합니다. 주소 자체는 secret이 아닙니다.
#
# 로컬 개발처럼 외부 주소가 없으면 비워 둡니다.
# 그때는 화면에서 Chat ID를 직접 등록합니다.
#
# 알림을 받을 Telegram 그룹은 여기에 적지 않습니다.
# 그룹은 화면에서 등록하고 Manager Database가 관리합니다.
# ---------------------------------------------------------------------------
TELEGRAM_WEBHOOK_PUBLIC_URL=

# ---------------------------------------------------------------------------
# 시간대
#
# Manager Database에는 모든 시각을 UTC로 저장합니다.
# 화면은 브라우저 시간대로 보여 줍니다.
# 이 값은 Telegram 메시지에 적는 시각에만 씁니다.
# ---------------------------------------------------------------------------
MANAGER_TIME_ZONE=Asia/Seoul
