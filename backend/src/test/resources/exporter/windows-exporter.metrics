windows_cpu_time_total{core="0,1",mode="idle"} 9100
windows_cpu_time_total{core="0,1",mode="interrupt"} 7.5
windows_cpu_time_total{core="0,1",mode="privileged"} 350
windows_cpu_time_total{core="0,1",mode="user"} 550
